# ================== CORE SETTINGS ==================
APP_NAME=ScrumKitchenMetrics
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text # text|json
TIMEZONE=Europe/Moscow

# ================== JIRA SETTINGS ==================
JIRA_ENABLED=true
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_API_TOKEN=changeme
JIRA_USER_EMAIL=you@company.com
JIRA_JQL_FILTER=project = DEMO AND sprint in openSprints()
JIRA_VERIFY_SSL=true

# ================== GITLAB SETTINGS ==================
GITLAB_ENABLED=true
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PRIVATE_TOKEN=changeme
GITLAB_PROJECT_IDS=12345,67890
GITLAB_VERIFY_SSL=true

# ================== REPORT GENERATION ==================
REPORT_OUTPUT_DIR=reports
REPORT_FORMATS=PDF,XLSX
TEMPLATE_DIR=templates
REPORT_TEMPLATE=summary.html.j2
REPORT_PDF_ENGINE=reportlab # reportlab|weasyprint

# ================== EMAIL SENDING ==================
EMAIL_ENABLED=true
EMAIL_PROVIDER=gmail # options: gmail, exchange
EMAIL_SUBJECT_PREFIX=[Metrics]
EMAIL_SEND_PDF=true
EMAIL_SEND_XLSX=true
EMAIL_TO=team@company.com,po@company.com
EMAIL_FROM=metrics-bot@company.com

# ---- Gmail (if EMAIL_PROVIDER=gmail) ----
GMAIL_SMTP_SERVER=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USER=metrics.bot@gmail.com
GMAIL_APP_PASSWORD=app_password_here

# ---- Exchange / Office365 (if EMAIL_PROVIDER=exchange) ----
EXCHANGE_SMTP_SERVER=smtp.office365.com
EXCHANGE_SMTP_PORT=587
EXCHANGE_USER=metrics.bot@company.com
EXCHANGE_PASSWORD=super_secret_here

# ================== SCHEDULER (optional) ==================
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 8 * * 1-5

# ================== SECURITY / NETWORK ==================
HTTP_TIMEOUT=30
HTTP_RETRIES=3
PROXY_URL=
CACHE_ENABLED=false
CACHE_TTL=300
CACHE_DIR=.api_cache

# ================== FEATURE FLAGS ==================
FEATURE_INCLUDE_CYCLE_TIME=true
FEATURE_INCLUDE_BUG_RATIO=true
FEATURE_INCLUDE_DEPLOY_FREQUENCY=true
PLUGINS_ENABLED=false

# ================== API SERVER ==================
API_ENABLED=false
API_HOST=0.0.0.0
API_PORT=8000

